{
  "name": "newyorkfed",
  "version": "1.0.0",
  "description": "Typed, zero-dependency client for the NY Fed's free Markets Data API — SOFR, EFFR, OBFR, BGCR, TGCR reference rates, SOFR averages & index, SOMA holdings. No API key required.",
  "keywords": [
    "newyorkfed",
    "ny-fed",
    "sofr",
    "effr",
    "obfr",
    "reference-rates",
    "fed-funds",
    "interest-rates",
    "federal-reserve",
    "soma",
    "fixed-income",
    "finance",
    "api-client"
  ],
  "homepage": "https://moshemalka.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshejs/newyorkfed.git"
  },
  "bugs": "https://github.com/moshejs/newyorkfed/issues",
  "author": "Moshe Malka <hello@moshemalka.com> (https://moshemalka.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
